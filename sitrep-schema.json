{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sitrep-am/sitrep-schema.json",
  "title": "SITREP-AM",
  "type": "object",
  "required": ["metadata", "resumoExecutivo", "indicadores", "eventos", "fronteiraColombia", "radarTematico", "acompanhamento", "historico30Dias", "fontes"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["titulo", "atualizadoEm", "periodoInicio", "periodoFim", "fusoHorario", "status"],
      "properties": {
        "titulo": { "type": "string", "minLength": 1 },
        "subtitulo": { "type": "string" },
        "versao": { "type": "string" },
        "atualizadoEm": { "type": "string", "format": "date-time" },
        "periodoInicio": { "type": "string", "format": "date-time" },
        "periodoFim": { "type": "string", "format": "date-time" },
        "fusoHorario": { "const": "America/Sao_Paulo" },
        "status": { "type": "string" }
      }
    },
    "resumoExecutivo": {
      "type": "object",
      "required": ["situacao", "impacto", "perspectiva"],
      "properties": {
        "situacao": { "type": "string" },
        "impacto": { "type": "string" },
        "perspectiva": { "type": "string" }
      }
    },
    "indicadores": { "type": "object" },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "classificacao", "criticidade", "categoria", "titulo", "dataHora", "localizacao", "resumo", "impactoOperacional", "tendencia", "confianca", "fonte"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classificacao": { "enum": ["FATO CONFIRMADO", "INFORMAÇÃO PRELIMINAR", "AVALIAÇÃO ANALÍTICA", "HIPÓTESE", "SEM CONFIRMAÇÃO INDEPENDENTE"] },
          "criticidade": { "enum": ["normal", "atencao", "alerta", "critico"] },
          "categoria": { "type": "string", "minLength": 1 },
          "titulo": { "type": "string", "minLength": 1 },
          "dataHora": { "type": "string", "format": "date-time" },
          "localizacao": { "type": "string", "minLength": 1 },
          "impacto": { "type": "integer", "minimum": 1, "maximum": 5 },
          "probabilidadeAgravamento": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confiabilidadeFonte": { "enum": ["A", "B", "C", "D", "E", "F"] },
          "credibilidadeInformacao": { "type": "integer", "minimum": 1, "maximum": 6 },
          "coordenadas": {
            "type": ["object", "null"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 },
              "precisao": { "type": "string" }
            },
            "required": ["lat", "lon", "precisao"]
          },
          "fonte": {
            "type": "object",
            "required": ["nome", "url", "tipo", "confirmacoes", "evidencia"],
            "properties": {
              "nome": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "tipo": { "enum": ["primária", "secundária", "primária indireta"] },
              "confirmacoes": { "type": "integer", "minimum": 1 },
              "evidencia": { "type": "string" }
            }
          }
        }
      }
    },
    "fronteiraColombia": { "type": "array" },
    "radarTematico": { "type": "array" },
    "briefingDiario": { "type": "array" },
    "acompanhamento": { "type": "array" },
    "historico30Dias": { "type": "array" },
    "fontes": { "type": "array" }
  }
}
